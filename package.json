{
  "name": "my-librarian",
  "version": "0.1.0",
  "type": "module",
  "description": "A record of what your AI sessions decided — and the receipts behind it. MCP server over a folder of markdown notes.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shinytoyrobots/my-librarian.git"
  },
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "my-librarian": "./dist/stdio.js"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "reindex": "tsx src/reindex.ts",
    "search": "tsx src/search-cli.ts",
    "recent": "tsx src/recent-cli.ts",
    "gate": "tsx src/gate-cli.ts",
    "identity-confirm": "tsx src/identity-confirm-cli.ts",
    "capture": "tsx src/capture-cli.ts",
    "install-hook": "node hooks/install-hook.mjs",
    "site-drift": "node scripts/site-drift.mjs",
    "start": "tsx src/stdio.ts",
    "start:built": "node dist/stdio.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "gray-matter": "^4.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
